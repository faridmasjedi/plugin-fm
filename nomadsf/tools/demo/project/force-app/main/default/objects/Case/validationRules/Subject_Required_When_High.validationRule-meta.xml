<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Subject_Required_When_High</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Priority, &quot;High&quot;), ISBLANK(Subject))</errorConditionFormula>
    <errorDisplayField>Subject</errorDisplayField>
    <errorMessage>High priority cases need a subject.</errorMessage>
</ValidationRule>
