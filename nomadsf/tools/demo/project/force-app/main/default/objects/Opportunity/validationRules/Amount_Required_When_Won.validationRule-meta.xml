<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Amount_Required_When_Won</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(StageName, &apos;Closed Won&apos;), ISBLANK(Amount))</errorConditionFormula>
    <errorDisplayField>Amount</errorDisplayField>
    <errorMessage>A won opportunity needs an amount.</errorMessage>
</ValidationRule>
