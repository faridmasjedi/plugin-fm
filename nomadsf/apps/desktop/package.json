{
  "name": "nomadsf-desktop",
  "productName": "NomadSF",
  "version": "1.0.0",
  "private": true,
  "description": "NomadSF desktop app: NomadSF Studio and the NomadSF app for a Salesforce DX project, in its own window (uses the Salesforce CLI's login).",
  "author": "Farid Masjedi",
  "license": "Apache-2.0",
  "homepage": "https://faridmasjedi.github.io/plugin-fm/",
  "repository": {
    "type": "git",
    "url": "https://github.com/faridmasjedi/plugin-fm",
    "directory": "nomadsf/apps/desktop"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "npx --yes electron-builder@25.1.8 --publish never",
    "test": "node --test test/app.test.js"
  },
  "devDependencies": {
    "electron": "33.2.1"
  },
  "build": {
    "appId": "dev.nomadsf.desktop",
    "productName": "NomadSF",
    "files": [
      "main.js",
      "src/**",
      "build/icon.png"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png"
    },
    "copyright": "Copyright © 2026 Farid Masjedi",
    "directories": {
      "buildResources": "build"
    }
  }
}
