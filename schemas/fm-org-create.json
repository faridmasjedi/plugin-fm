{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/OrgCreateResult",
  "definitions": {
    "OrgCreateResult": {
      "type": "object",
      "properties": {
        "alias": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "ok": {
                "type": "boolean"
              },
              "message": {
                "type": "string"
              },
              "durationMs": {
                "type": "number"
              }
            },
            "required": ["id", "label", "ok", "durationMs"],
            "additionalProperties": false
          }
        },
        "dryRun": {
          "type": "boolean"
        }
      },
      "required": ["alias", "steps", "dryRun"],
      "additionalProperties": false
    }
  }
}
