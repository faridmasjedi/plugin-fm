{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/CheckDuplicatesResult",
  "definitions": {
    "CheckDuplicatesResult": {
      "type": "object",
      "properties": {
        "hasDuplicates": {
          "type": "boolean"
        },
        "totalDuplicates": {
          "type": "number"
        },
        "componentDuplicates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "context": {
                "type": "string"
              },
              "parentFile": {
                "type": "string"
              },
              "submoduleFile": {
                "type": "string"
              },
              "submodulePath": {
                "type": "string"
              },
              "parentFiles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "submoduleFiles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": ["type", "name", "parentFile", "submoduleFile", "submodulePath"],
            "additionalProperties": false
          }
        },
        "granularDuplicates": {
          "type": "object",
          "properties": {
            "customLabels": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "labelName": {
                    "type": "string"
                  },
                  "parentFile": {
                    "type": "string"
                  },
                  "submoduleFile": {
                    "type": "string"
                  },
                  "submodulePath": {
                    "type": "string"
                  }
                },
                "required": ["labelName", "parentFile", "submoduleFile", "submodulePath"],
                "additionalProperties": false
              }
            },
            "sharingRules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "objectName": {
                    "type": "string"
                  },
                  "ruleName": {
                    "type": "string"
                  },
                  "parentFile": {
                    "type": "string"
                  },
                  "submoduleFile": {
                    "type": "string"
                  },
                  "submodulePath": {
                    "type": "string"
                  }
                },
                "required": ["objectName", "ruleName", "parentFile", "submoduleFile", "submodulePath"],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["hasDuplicates", "totalDuplicates", "componentDuplicates", "granularDuplicates"],
      "additionalProperties": false
    }
  }
}
