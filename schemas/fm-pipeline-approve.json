{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/PipelineApproveResult",
  "definitions": {
    "PipelineApproveResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runId": {
          "type": "string"
        },
        "stageId": {
          "type": "string"
        },
        "decision": {
          "type": "string",
          "enum": ["approve", "reject"]
        },
        "by": {
          "type": "string"
        },
        "at": {
          "type": "string"
        }
      },
      "required": ["at", "by", "decision", "runId", "stageId"]
    }
  }
}
